{
  "name": "aperas-monorepo",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @aperas/web run dev",
    "build:web": "npm --workspace @aperas/web run build",
    "aperas": "tsx packages/cli/src/aperas.ts",
    "build:aperas": "node packages/cli/build.mjs",
    "verify": "node packages/cli/src/tests/run.mjs",
    "svc:sample": "python3 packages/cli/diagnostics/svc_sampler.py",
    "svc:sample:test": "python3 -m unittest packages/cli/diagnostics/test_svc_sampler.py"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}